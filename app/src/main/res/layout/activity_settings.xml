<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="32sp" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textSize="15sp" />

        <!-- Shown only while the accessibility service is off. -->
        <LinearLayout
            android:id="@+id/permission_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/warning_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/service_missing"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/grant_button"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant" />
        </LinearLayout>

        <!-- Master toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <Switch
                android:id="@+id/master_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/master_toggle"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/status_text"
                style="@style/Hint"
                android:layout_marginTop="4dp"
                android:text="@string/status_stopped" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:animateLayoutChanges="true">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_speed" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionLabel"
                    android:text="@string/refresh_interval" />

                <TextView
                    android:id="@+id/interval_value"
                    style="@style/SectionValue" />
            </LinearLayout>

            <!-- One radio button per RefreshPreset, added in code. -->
            <RadioGroup
                android:id="@+id/interval_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- Shown only for the Custom preset. -->
            <LinearLayout
                android:id="@+id/custom_interval"
                style="@style/FeatureOptions">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/custom_interval_seek"
                        android:text="@string/custom_interval" />

                    <TextView
                        android:id="@+id/custom_interval_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/custom_interval_seek"
                    style="@style/Slider" />

            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="@string/interval_hint" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:animateLayoutChanges="true">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_look" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionLabel"
                    android:labelFor="@id/warmth_seek"
                    android:text="@string/warmth" />

                <TextView
                    android:id="@+id/warmth_value"
                    style="@style/SectionValue" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="@string/warmth_hint" />

            <SeekBar
                android:id="@+id/warmth_seek"
                style="@style/Slider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionLabel"
                    android:labelFor="@id/contrast_seek"
                    android:text="@string/contrast" />

                <TextView
                    android:id="@+id/contrast_value"
                    style="@style/SectionValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/contrast_seek"
                style="@style/Slider" />

            <Switch
                android:id="@+id/posterize_switch"
                style="@style/FeatureSwitch"
                android:text="@string/posterize" />

            <TextView
                style="@style/Hint"
                android:text="@string/posterize_hint" />

            <!-- Sub-settings: shown only while the switch above is on. -->
            <LinearLayout
                android:id="@+id/posterize_options"
                style="@style/FeatureOptions">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/levels_seek"
                        android:text="@string/grey_levels" />

                    <TextView
                        android:id="@+id/levels_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/levels_seek"
                    style="@style/Slider" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:animateLayoutChanges="true">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_style" />

            <Switch
                android:id="@+id/ghosting_switch"
                style="@style/FeatureSwitch"
                android:text="@string/ghosting" />

            <TextView
                style="@style/Hint"
                android:text="@string/ghosting_hint" />

            <!-- Sub-settings: shown only while the switch above is on. -->
            <LinearLayout
                android:id="@+id/ghosting_options"
                style="@style/FeatureOptions">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/ghost_opacity_seek"
                        android:text="@string/ghost_opacity" />

                    <TextView
                        android:id="@+id/ghost_opacity_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/ghost_opacity_seek"
                    style="@style/Slider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/ghost_fade_seek"
                        android:text="@string/ghost_fade" />

                    <TextView
                        android:id="@+id/ghost_fade_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/ghost_fade_seek"
                    style="@style/Slider" />

            </LinearLayout>

            <Switch
                android:id="@+id/full_refresh_switch"
                style="@style/FeatureSwitch"
                android:text="@string/full_refresh" />

            <TextView
                style="@style/Hint"
                android:text="@string/full_refresh_hint" />

            <!-- Sub-settings: shown only while the switch above is on. -->
            <LinearLayout
                android:id="@+id/full_refresh_options"
                style="@style/FeatureOptions">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/full_refresh_seek"
                        android:text="@string/full_refresh_every" />

                    <TextView
                        android:id="@+id/full_refresh_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/full_refresh_seek"
                    style="@style/Slider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/flash_duration_seek"
                        android:text="@string/flash_duration" />

                    <TextView
                        android:id="@+id/flash_duration_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/flash_duration_seek"
                    style="@style/Slider" />

            </LinearLayout>

            <Switch
                android:id="@+id/on_change_switch"
                style="@style/FeatureSwitch"
                android:text="@string/refresh_on_change" />

            <TextView
                style="@style/Hint"
                android:layout_marginBottom="16dp"
                android:text="@string/refresh_on_change_hint" />
        </LinearLayout>

        <Button
            android:id="@+id/preview_button"
            style="@android:style/Widget.Material.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="@string/hold_to_preview"
            android:textSize="16sp" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="@string/preview_hint" />
    </LinearLayout>
</ScrollView>
