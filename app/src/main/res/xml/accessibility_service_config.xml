<?xml version="1.0" encoding="utf-8"?>
<!--
  PaperScreen rebuilds the screen from per-window screenshots underneath its own overlay:
  - flagRetrieveInteractiveWindows + canRetrieveWindowContent: getWindows() lists the windows
    to capture. PaperScreen reads each window's id, layer and bounds, never its view content.
  - canTakeScreenshot: takeScreenshotOfWindow() for each of those windows.
  - The event types are the ones that usually mean something visible changed; they drive
    "refresh only when the screen changes".
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged|typeWindowsChanged|typeViewScrolled|typeViewTextChanged|typeViewTextSelectionChanged|typeViewSelected|typeViewClicked|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.paperscreen.SettingsActivity"
    android:summary="@string/accessibility_summary" />
