<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings: one page in the same book as the home screen. Plain text on paper, grouped under
  small section headers and separated by hairlines. Colours and the typeface are applied in
  code (SettingsPage) from the warmth and home screen font settings.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="TooManyViews,PxUsage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <!-- Header: the master switch, and a one-line summary of the setup. -->
        <Switch
            android:id="@+id/master_switch"
            style="@style/MasterSwitch"
            android:text="@string/master_toggle" />

        <TextView
            android:id="@+id/status_text"
            style="@style/Summary"
            android:layout_marginTop="2dp"
            tools:text="Filtering active · Standard · 16 greys · Warmth 20" />

        <!-- Shown only while the accessibility service is off. -->
        <LinearLayout
            android:id="@+id/permission_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:tag="box"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/service_missing"
                android:textSize="14sp" />

            <Button
                android:id="@+id/grant_button"
                style="@style/TextButton"
                android:layout_marginStart="12dp"
                android:text="@string/grant" />
        </LinearLayout>

        <View style="@style/SectionRule" />

        <!-- Display: the filter itself, in the order you'd tune it. -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_display" />

            <LinearLayout style="@style/SliderRow">

                <TextView
                    style="@style/SectionLabel"
                    android:labelFor="@id/warmth_seek"
                    android:text="@string/warmth" />

                <TextView
                    android:id="@+id/warmth_value"
                    style="@style/SectionValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/warmth_seek"
                style="@style/Slider" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="-6dp"
            android:text="@string/warmth_hint" />

        <!-- Shown while Night warmth sets the warmth instead of this slider. -->
        <TextView
            android:id="@+id/warmth_controlled"
            style="@style/Hint"
            android:layout_marginTop="0dp"
            android:tag="note"
            android:text="@string/warmth_controlled"
            android:visibility="gone" />

            <LinearLayout style="@style/SliderRow">

                <TextView
                    style="@style/SectionLabel"
                    android:labelFor="@id/contrast_seek"
                    android:text="@string/contrast" />

                <TextView
                    android:id="@+id/contrast_value"
                    style="@style/SectionValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/contrast_seek"
                style="@style/Slider" />

        <Switch
            android:id="@+id/posterize_switch"
            style="@style/FeatureSwitch"
            android:text="@string/posterize" />

        <TextView
            style="@style/Hint"
            android:text="@string/posterize_hint" />

        <!-- Sub-settings: shown only while the switch above is on. -->
        <LinearLayout
            android:id="@+id/posterize_options"
            style="@style/FeatureOptions">

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/levels_seek"
                        android:text="@string/grey_levels" />

                    <TextView
                        android:id="@+id/levels_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/levels_seek"
                    style="@style/Slider" />

        </LinearLayout>

        <View style="@style/SectionRule" />

        <!-- Refresh: how and when the screen updates. -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_refresh" />

        <LinearLayout style="@style/SliderRow">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/refresh_interval" />

            <TextView
                android:id="@+id/interval_value"
                style="@style/SectionValue" />
        </LinearLayout>

        <!-- One radio button per RefreshPreset, added in code. -->
        <RadioGroup
            android:id="@+id/interval_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <!-- Shown only for the Custom preset. -->
        <LinearLayout
            android:id="@+id/custom_interval"
            style="@style/FeatureOptions">

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/custom_interval_seek"
                        android:text="@string/custom_interval" />

                    <TextView
                        android:id="@+id/custom_interval_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/custom_interval_seek"
                    style="@style/Slider" />

        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="2dp"
            android:text="@string/interval_hint" />

        <Switch
            android:id="@+id/on_change_switch"
            style="@style/FeatureSwitch"
            android:text="@string/refresh_on_change" />

        <TextView
            style="@style/Hint"
            android:text="@string/refresh_on_change_hint" />

        <Switch
            android:id="@+id/ghosting_switch"
            style="@style/FeatureSwitch"
            android:text="@string/ghosting" />

        <TextView
            style="@style/Hint"
            android:text="@string/ghosting_hint" />

        <!-- Sub-settings: shown only while the switch above is on. -->
        <LinearLayout
            android:id="@+id/ghosting_options"
            style="@style/FeatureOptions">

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/ghost_opacity_seek"
                        android:text="@string/ghost_opacity" />

                    <TextView
                        android:id="@+id/ghost_opacity_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/ghost_opacity_seek"
                    style="@style/Slider" />

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/ghost_fade_seek"
                        android:text="@string/ghost_fade" />

                    <TextView
                        android:id="@+id/ghost_fade_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/ghost_fade_seek"
                    style="@style/Slider" />

        </LinearLayout>

        <Switch
            android:id="@+id/full_refresh_switch"
            style="@style/FeatureSwitch"
            android:text="@string/full_refresh" />

        <TextView
            style="@style/Hint"
            android:text="@string/full_refresh_hint" />

        <!-- Sub-settings: shown only while the switch above is on. -->
        <LinearLayout
            android:id="@+id/full_refresh_options"
            style="@style/FeatureOptions">

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/full_refresh_seek"
                        android:text="@string/full_refresh_every" />

                    <TextView
                        android:id="@+id/full_refresh_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/full_refresh_seek"
                    style="@style/Slider" />

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/flash_duration_seek"
                        android:text="@string/flash_duration" />

                    <TextView
                        android:id="@+id/flash_duration_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/flash_duration_seek"
                    style="@style/Slider" />

        </LinearLayout>

        <View style="@style/SectionRule" />

        <!-- Night warmth. -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_night" />

        <Switch
            android:id="@+id/night_switch"
            style="@style/FeatureSwitch"
            android:text="@string/night_warmth" />

        <TextView
            style="@style/Hint"
            android:text="@string/night_warmth_hint" />

        <!-- Sub-settings: shown only while Night warmth is on. -->
        <LinearLayout
            android:id="@+id/night_options"
            style="@style/FeatureOptions">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/night_schedule" />

            <!-- One radio button per NightScheduleMode, added in code. -->
            <RadioGroup
                android:id="@+id/night_schedule_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <!-- Only for the Custom schedule. -->
            <LinearLayout
                android:id="@+id/night_custom_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/night_start_button"
                        android:text="@string/night_starts" />

                    <Button
                        android:id="@+id/night_start_button"
                        style="@style/TextButton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/night_end_button"
                        android:text="@string/night_ends" />

                    <Button
                        android:id="@+id/night_end_button"
                        style="@style/TextButton" />
                </LinearLayout>
            </LinearLayout>

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/day_warmth_seek"
                        android:text="@string/day_warmth" />

                    <TextView
                        android:id="@+id/day_warmth_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/day_warmth_seek"
                    style="@style/Slider" />

                <LinearLayout style="@style/SliderRow">

                    <TextView
                        style="@style/SectionLabel"
                        android:labelFor="@id/night_warmth_seek"
                        android:text="@string/night_warmth_level" />

                    <TextView
                        android:id="@+id/night_warmth_value"
                        style="@style/SectionValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/night_warmth_seek"
                    style="@style/Slider" />

            <Switch
                android:id="@+id/night_transition_switch"
                style="@style/FeatureSwitch"
                android:layout_marginTop="0dp"
                android:text="@string/night_transition" />

            <TextView
                style="@style/Hint"
                android:text="@string/night_transition_hint" />

            <TextView
                android:id="@+id/night_status"
                style="@style/Hint"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:tag="note" />
        </LinearLayout>

        <View style="@style/SectionRule" />

        <!-- Home screen. -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_home" />

        <Switch
            android:id="@+id/home_switch"
            style="@style/FeatureSwitch"
            android:text="@string/home_screen" />

        <TextView
            style="@style/Hint"
            android:text="@string/home_screen_hint" />

        <!-- Shown only while PaperScreen is the default home app. -->
        <LinearLayout
            android:id="@+id/home_options"
            style="@style/FeatureOptions">

            <Switch
                android:id="@+id/clock_24h_switch"
                style="@style/FeatureSwitch"
                android:layout_marginTop="0dp"
                android:text="@string/clock_24h" />

            <TextView
                style="@style/Hint"
                android:text="@string/clock_24h_hint" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/clock_size" />

            <!-- One radio button per ClockSize, added in code. -->
            <RadioGroup
                android:id="@+id/clock_size_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <Switch
                android:id="@+id/show_date_switch"
                style="@style/FeatureSwitch"
                android:text="@string/show_date" />

            <Switch
                android:id="@+id/show_seconds_switch"
                style="@style/FeatureSwitch"
                android:layout_marginTop="0dp"
                android:text="@string/show_seconds" />

            <TextView
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/home_font" />

            <!-- One radio button per HomeFont, each in its own typeface, added in code. -->
            <RadioGroup
                android:id="@+id/home_font_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <View style="@style/SectionRule" />

        <!-- Footer: preview, about, and reset. -->
        <Button
            android:id="@+id/preview_button"
            style="@style/OutlineButton"
            android:layout_marginTop="24dp"
            android:text="@string/hold_to_preview" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="@string/preview_hint" />

        <TextView
            style="@style/SectionHeader"
            android:layout_marginTop="28dp"
            android:text="@string/section_about" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/about_description" />

            <TextView
                android:id="@+id/about_version"
                style="@style/SectionValue"
                tools:text="Version 1.0" />
        </LinearLayout>

        <Button
            android:id="@+id/support_button"
            style="@style/TextButton"
            android:text="@string/support_development" />

        <View style="@style/SectionRule" />

        <Button
            android:id="@+id/reset_all_button"
            style="@style/TextButton"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/reset_all" />
    </LinearLayout>
</ScrollView>
